# ── Local development setup ───────────────────────────────────────────────────
#
# These values are referenced in application.properties as ${VAR_NAME}.
# Spring Boot resolves them from OS environment variables, or from a profile-
# specific properties file.
#
# For local dev (easiest):
#   1. Copy src/main/resources/application-local.properties
#   2. Fill in your real values
#   3. Run with: mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# For production / CI:
#   Set these as real OS environment variables or secrets manager entries.
#
# ─────────────────────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

MAIL_USERNAME=your-gmail@gmail.com
# Use a Gmail App Password (not your account password).
# Generate one at: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=your-16-char-app-password
